# PostCraft AI — Root .gitignore

# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ─── Node / Next.js / TypeScript ─────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/

# ─── Environment & Secrets ───────────────────────────
.env
.env*
*.env
*.env.*
!.env.example
!*.env.example

# ─── Certificates & Credentials ──────────────────────
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json
service_account*.json

# ─── IDE & OS ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.claude/
.playwright-cli/
.agents/
skills-lock.json

# ─── Docker ──────────────────────────────────────────
docker-compose.override.yml

# ─── Testing / Coverage ─────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ─── Misc & Logs ────────────────────────────────────
*.log
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Local Databases & Storage ───────────────────────
*.sqlite3
*.db
**/chroma_db/
backend/chroma_db/
backend/postcraft.db

# ─── Design references (Stitch HTML exports, kept locally only) ───
design-reference/
