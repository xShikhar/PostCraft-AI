# ─── Environment ──────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# ─── Database ──────────────────────────────────────────
# Production (Supabase Permanent Free Tier — use Session Pooler on port 5432 for IPv4):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development (Docker PostgreSQL or local SQLite):
DATABASE_URL=postgresql+asyncpg://postcraft:postcraft@localhost:5432/postcraft

# ─── Security (REQUIRED — fail closed if missing) ──────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=
# Comma-separated usernames automatically granted admin on signup/login (optional)
ADMIN_USERNAMES=

# ─── AI / Search API Keys ──────────────────────────────
GEMINI_API_KEY=
SERP_API_KEY=
TAVILY_API_KEY=

# ─── ChromaDB ──────────────────────────────────────────
# On Render: point to the ChromaDB service hostname (or use HTTP mode below)
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Persist ChromaDB to disk on Render. Defaults to ./chroma_data.
CHROMA_PERSIST_DIR=./chroma_data

# ─── CORS / Hosts ──────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Example: https://postcraft.vercel.app,https://app.yourdomain.com
CORS_ORIGINS=https://localhost,http://localhost:3000
# Comma-separated list of allowed hosts (TrustedHostMiddleware)
ALLOWED_HOSTS=localhost,127.0.0.1,postcraft-backend

# ─── Sentry (optional) ────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
