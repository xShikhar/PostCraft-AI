# Local development. Production values belong in the hosting secret manager.
ENVIRONMENT=development
DEBUG=False
DATABASE_URL=postgresql+asyncpg://postcraft:postcraft@localhost:5432/postcraft
# True for public managed PostgreSQL (verified TLS); False for local/internal Compose DB.
DATABASE_SSL=False
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Blank FAST/DRAFT fall back to GEMINI_MODEL.
GEMINI_FAST_MODEL=
GEMINI_DRAFT_MODEL=
TAVILY_API_KEY=
SERP_API_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_STORAGE_URI=memory://
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
MODEL_TOKEN_PRICES={}
COST_PROMPT_PER_MILLION=0.30
COST_COMPLETION_PER_MILLION=2.50
PORT=8000
